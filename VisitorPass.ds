 application "VisitorPass"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "UTC"
 	time format = "24-hr"

 	forms
	{
		form Appointment
		{
			success message = "Appointment Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Appointment_ID
			(
    			type = autonumber
				start index = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			Visit_Type
			(
				type = radiobuttons
				maxchar = 100
				values = {"Pre-Scheduled","Walk-in","Recurring"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Visitor_Email
			(
    			type = email
				maxchar = 80
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Visitor_Phone
			(
    			type = phonenumber
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Visitor
			(
				type = picklist	
				values  = Visitor.ID
    			displayformat = [Visitor_Name.first_name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Host
			(
				type = picklist	
				values  = Employee.ID
    			displayformat = [Employee_ID]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Department_Name
			(
				type = picklist	
				displayname = "Department"
				values  = Department.ID
    			displayformat = [Department_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Purpose_Category
			(
				type = picklist
				maxchar = 100
				values = {"Meeting","Interview","Delivery","Maintenance","Audit","Personal"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Purpose_Details
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Start_DateTime
			(
    			type = datetime
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			End_DateTime
			(
    			type = datetime
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Meeting_Room
			(
				type = picklist	
				values  = Meeting_Room.ID
    			displayformat = [Room_Code1]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Requires_Parking
			(
				type = checkboxes	
				values = {"Yes","No","Yet to decide"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Requires_Hospitality
			(
				type = checkboxes	
				values = {"Yes","No"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Status
			(
				type = picklist
				maxchar = 100
				values = {"Requested","Approved","Rejected","Checked In","Checked Out","Cancelled","No Show"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Approval_Remarks
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Approved_On
			(
    			type = datetime
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Cancellation_Reason
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			Visit_Duration_Mins
			(
				type = number
	 			row = 1
	 			column = 1   
				width = medium
			)
			Total_Visitors
			(
				type = number
	 			row = 1
	 			column = 1   
				width = medium
    			Formula_Properties
    			(
    						value =  input.Additional_Visitors.count() + 1
    						visibility = false
    			)
			)
			Host_Login_Email
			(
    			type = email
				maxchar = 80
	 			row = 1
	 			column = 1   
				width = medium
			)
			Reminder_Sent
			(
    			type = checkbox
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			Additional_Visitors
			(
				type = grid
				Full_Name
				(
    				type = text
					width = medium
				)
				Phone_Number
				(
    				type = phonenumber
					displayname = "Phone"
					width = medium
					personal data = true
				)
				Email
				(
    				type = email
					maxchar = 80
					width = medium
					personal data = true
				)
				Company
				(
    				type = text
					width = medium
				)
				Designation
				(
    				type = text
					width = medium
				)
	 			row = 2
	 			column = 1   
				width = medium
			)
			Items_Carried
			(
				type = grid
				Item_Type
				(
					type = picklist
					maxchar = 100
					values = {"Laptop","Camera","Tools","Documents","Pen Drive","Other"}
					width = medium
				)
				Item_Description
				(
    				type = text
					width = medium
				)
				Brand_Model
				(
    				type = text
					width = medium
				)
				Quantity
				(
					type = number
					width = medium
				)
	 			row = 3
	 			column = 1   
				width = medium
			)
			Vehicle_Details
			(
				type = grid
				Vehicle_Type
				(
					type = picklist
					displayname = "Vehicle_Type\\"
					maxchar = 100
					values = {"Car","Bike","Van","Truck"}
					width = medium
				)
				Registration_Number
				(
    				type = text
					width = medium
				)
				Make_Model
				(
    				type = text
					width = medium
				)
				Driver_Name
				(
    				type = text
					width = medium
				)
				Driver_Mobile
				(
    				type = phonenumber
					width = medium
					personal data = true
				)
				Parking_Slot
				(
    				type = text
					width = medium
				)
				Entry_Time
				(
    				type = datetime
					timedisplayoptions = "hh:mm:ss"
					alloweddays = 0,1,2,3,4,5,6
					width = medium
				)
	 			row = 4
	 			column = 1   
				width = medium
			)
			Internal_Attendees
			(
				type = grid
				Employee
				(
					type = picklist	
					values  = Employee.ID
    				displayformat = [Employee_ID]
					sortorder = ascending
					width = medium
				)
				Email
				(
    				type = email
					maxchar = 80
					width = medium
					personal data = true
				)
				Role_In_Meeting
				(
					type = picklist
					maxchar = 100
					values = {"Organizer","Presenter","Participant","Observer"}
					width = medium
				)
				Attendance_Status
				(
					type = picklist
					maxchar = 100
					values = {"Invited","Accepted","Declined","Attended"}
					width = medium
				)
				Remarks
				(
    				type = text
					width = medium
				)
	 			row = 5
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Check_In_Out_Log
		{
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Appointment
			(
				type = picklist	
				values  = Appointment.ID
    			displayformat = [Appointment_ID]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Visitor_Pass
			(
				type = picklist	
				values  = Visitor_Pass.ID
    			displayformat = [Pass_No]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Gate
			(
				type = picklist
				maxchar = 100
				values = {"Main Gate","East Gate","West Gate"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Check_In_Time
			(
    			type = datetime
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Check_Out_Time
			(
    			type = datetime
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Body_Temperature
			(
				type = decimal
				displayname = " Body_Temperature"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Health_Declaration
			(
    			type = checkbox
				displayname = "Health_Declaration "
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			Belongings_Verified
			(
				type = checkboxes	
				values = {"Verified","Not Verified"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Security_Officer
			(
    			type = picklist
				module = users
				displayformat = [username]
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Badge_Returned
			(
				type = checkboxes	
				values = {"Yes","No"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Overstay_Alert_Sent
			(
    			type = checkbox
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Department
		{
