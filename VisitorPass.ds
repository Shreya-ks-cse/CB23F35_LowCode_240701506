		 functions
		 {
			 Deluge
			 {
				 void visitorpass.attachQRImage(int passID)
                 {
                 	// Fetch the Visitor_Pass record using the provided passID
                 	passRecord = Visitor_Pass[ID == passID];
                 	// Check if record exists
                 	if(passRecord.count() > 0)
                 	{
                 		// Get the Pass_No from the record
                 		passNo = passRecord.Pass_No;
                 		// Construct the QR code URL
                 		qrUrl = "https://api.qrserver.com/v1/create-qr-code/?size=250x250&format=png&data=" + passNo;
                 		// Invoke the URL to fetch the QR code image
                 		qrImage = invokeurl
                 		[
                 			url :qrUrl
                 			type :GET
                 		];
                 		// Store the image in the QR_Code field of the record
                 		passRecord.QR_Code=qrImage;
                 	}
                 	else
                 	{
                 		info "Visitor Pass record not found for ID: " + passID;
                 	}
                 }
			 }
		 }


		workflow
		{
		form
		{
			Appointment_Fill_Visitor_ as "Appointment_Fill_Visitor_Details"
			{
				type =  form
				form = Appointment

				record event = on add or edit

				on user input of Visitor
				{
					actions 
					{
						custom deluge script
						(
											if(input.Visitor != null)
										{
											v = Visitor[ID == input.Visitor];
											if(v != null)
											{
												input.Visitor_Email = v.Email;
												input.Visitor_Phone = v.Phone_Number;
											}
										}
						)
					}
				}

			}
			Appointment_Fill_Departme as "Appointment_Fill_Department"
			{
				type =  form
				form = Appointment

				record event = on add or edit

				on user input of Host
				{
					actions 
					{
						custom deluge script
						(
											if(input.Host != null)
										{
											emp = Employee[ID == input.Host];
											if(emp != null)
											{
												input.Department_Name = emp.Department_Name;
											}
										}
						)
					}
				}

			}
			Appointment_Validate as "Appointment_Validate"
			{
				type =  form
				form = Appointment

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Start_DateTime != null && input.Start_DateTime < zoho.currenttime)
										{
											alert "Start time cannot be in the past.";
											cancel submit;
										}
										if(input.Start_DateTime != null && input.End_DateTime != null)
										{
											if(input.End_DateTime <= input.Start_DateTime)
											{
												alert "End time must be after start time.";
												cancel submit;
											}
										}
										if(input.Meeting_Room != null && input.Start_DateTime != null && input.End_DateTime != null)
										{
											clash = Appointment[Meeting_Room == input.Meeting_Room && ID != input.ID && Status != "Cancelled" && Status != "Rejected" && Start_DateTime < input.End_DateTime && End_DateTime > input.Start_DateTime];
											if(clash.count() > 0)
											{
												alert "Meeting room is already booked for this slot.";
												cancel submit;
											}
										}
										if(input.Host != null && input.Start_DateTime != null && input.End_DateTime != null)
										{
											hostClash = Appointment[Host == input.Host && ID != input.ID && Status != "Cancelled" && Status != "Rejected" && Status != "No Show" && Status != "Checked Out" && Start_DateTime < input.End_DateTime && End_DateTime > input.Start_DateTime];
											if(hostClash.count() > 0)
											{
												alert "Host already has an appointment in this slot.";
												cancel submit;
											}
										}
						)
					}
				}

			}
			Appointment_Approval_Noti as "Appointment_Approval_Notification"
			{
				type =  form
				form = Appointment

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											host = Employee[ID == input.Host];
										if(host != null)
										{
											if(host.Auto_Approve_Visitors == true)
											{
												input.Status = "Approved";
											}
											else
											{
												input.Status = "Requested";
												sendmail
												[
													from :"shreyakorishetter06@gmail.com"
													to :host.Email
													subject :"Approval needed for visitor appointment"
													message :"Hello " + host.Employee_Name + ",<br><br>A visitor appointment requires your approval.<br><br>Appointment ID: " + input.Appointment_ID + "<br>Start time: " + input.Start_DateTime + "<br>Purpose: " + input.Purpose_Category + "<br><br>Please review the request in the Visitor Management System."
												]
											}
										}
						)
					}
				}

			}
			Send_Approval_Notificatio as "Send_Approval_Notification"
			{
				type =  form
				form = Appointment

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											visitorRecord = Visitor[ID == input.Visitor];
										if(visitorRecord != null)
										{
											if(input.Status == "Approved")
											{
												sendmail
												[
													from :"shreyakorishetter06@gmail.com"
													to :visitorRecord.Email
													subject :"Your visitor appointment is approved"
													message :"Hello " + visitorRecord.Visitor_Name + ",<br><br>Your visitor appointment has been approved.<br><br>Appointment ID: " + input.Appointment_ID + "<br>Start time: " + input.Start_DateTime + "<br><br>Please arrive at the scheduled time."
												]
											}
											else if(input.Status == "Rejected")
											{
												sendmail
												[
													from :"shreyakorishetter06@gmail.com"
													to :visitorRecord.Email
													subject :"Update on your visitor appointment"
													message :"Hello " + visitorRecord.Visitor_Name + ",<br><br>Unfortunately, your visitor appointment has been rejected.<br><br>Appointment ID: " + input.Appointment_ID + "<br><br>Please contact the host or administrator if you need further information."
												]
											}
										}
						)
					}
				}

			}
			Host_Approval_Update_Stat as "Host_Approval_Update_Status"
			{
				type =  form
				form = Host_Approval

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											appointmentRecord = Appointment[ID == input.Appointment];
										if(appointmentRecord != null)
										{
											if(input.Decision == "Approved")
											{
												appointmentRecord.Status="Approved";
												appointmentRecord.Approval_Remarks=input.Remarks;
												appointmentRecord.Approved_On=zoho.currenttime;
												existingPass = Visitor_Pass[Appointment == appointmentRecord.ID];
												if(existingPass.count() == 0)
												{
													insert into Visitor_Pass
													[
														Appointment=appointmentRecord.ID
														Visitor=appointmentRecord.Visitor
														Pass_Type="One-Time Visit"
														Valid_From=appointmentRecord.Start_DateTime
														Valid_Till=appointmentRecord.End_DateTime
														Pass_Status="Active"
														Added_User=zoho.loginuser
													]
												}
												visitorRecord = Visitor[ID == appointmentRecord.Visitor];
												if(visitorRecord != null)
												{
													sendmail
													[
														from :"shreyakorishetter06@gmail.com"
														to :visitorRecord.Email
														subject :"Your visitor appointment is approved"
														message :"Hello " + visitorRecord.Visitor_Name + ",<br><br>Your appointment has been approved by the host.<br><br>Appointment ID: " + appointmentRecord.Appointment_ID + "<br>Start time: " + appointmentRecord.Start_DateTime
													]
												}
											}
											else if(input.Decision == "Rejected")
											{
												appointmentRecord.Status="Rejected";
												visitorRecord = Visitor[ID == appointmentRecord.Visitor];
												if(visitorRecord != null)
												{
													sendmail
													[
														from :"shreyakorishetter06@gmail.com"
														to :visitorRecord.Email
														subject :"Your visitor appointment was rejected"
														message :"Hello " + visitorRecord.Visitor_Name + ",<br><br>Your appointment has been rejected by the host.<br><br>Appointment ID: " + appointmentRecord.Appointment_ID + "<br><br>Please contact the host or administrator for further information."
													]
												}
											}
										}
						)
					}
				}

			}
			Host_Approval_Update_Appo as "Host_Approval_Update_Appointment"
			{
				type =  form
				form = Host_Approval

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											if(input.Appointment != null)
										{
											appointmentRecord = Appointment[ID == input.Appointment];
											if(appointmentRecord != null)
											{
												if(input.Decision == "Approved")
												{
													appointmentRecord.Status="Approved";
													appointmentRecord.Approval_Remarks=input.Remarks;
													appointmentRecord.Approved_On=zoho.currenttime;
												}
												else if(input.Decision == "Rejected")
												{
													appointmentRecord.Status="Rejected";
													appointmentRecord.Approval_Remarks=input.Remarks;
												}
											}
										}
						)
					}
				}

			}
			Check_In_Time_Update_ as "Check_In_Time_Update."
			{
				type =  form
				form = Check_In_Out_Log

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											if(input.Check_In_Time == null)
										{
											input.Check_In_Time = zoho.currenttime;
										}
						)
					}
				}

			}
			Check_Out_Time_Update as "Check_Out_Time_Update"
			{
				type =  form
				form = Check_In_Out_Log

				record event = on edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											if(input.Check_Out_Time == null && input.Check_In_Time != null)
										{
											input.Check_Out_Time = zoho.currenttime;
										}
						)
					}
				}

			}
			Generate_Visitor_Pass as "Generate_Visitor_Pass"
			{
				type =  form
				form = Appointment

				record event = on edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											if(input.Status == "Approved")
										{
											existingPass = Visitor_Pass[Appointment == input.ID];
											if(existingPass.count() == 0)
											{
												insert into Visitor_Pass
												[
													Appointment=input.ID
													Visitor=input.Visitor
													Pass_Type="One-Time Visit"
													Valid_From=input.Start_DateTime
													Valid_Till=input.End_DateTime
													Pass_Status="Active"
													Added_User=zoho.loginuser
												]
											}
										}
						)
					}
				}

			}
			Send_SMS_On_Approval as "Send_SMS_On_Approval"
			{
				type =  form
				form = Appointment

				record event = on edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Fetch the visitor record linked to the approved appointment
										visitorRecord = Visitor[ID == input.Visitor.ID];
										// Validate visitor phone number exists
										if(visitorRecord.Phone_Number != null && visitorRecord.Phone_Number != "")
										{
											visitorPhone = visitorRecord.Phone_Number;
											visitorName = visitorRecord.Visitor_Name.first_name;
											appointmentID = input.Appointment_ID;
											meetingRoom = input.Meeting_Room.Room_Name;
											// Construct the SMS message
											smsMessage = "Dear " + visitorName + ", your appointment (ID: " + appointmentID + ") has been approved. Please visit " + meetingRoom + " for your meeting.";
											// TODO: Create a connection for Twilio/SMS service and replace "your_sms_connection" below
											// Example: twilio.sms.send("your_sms_connection", visitorPhone, smsMessage);
											// Since no connection is available in context, this task requires a connection setup
											info "SMS would be sent to " + visitorPhone + ": " + smsMessage;
										}
										else
										{
											info "Visitor phone number is missing. Cannot send SMS.";
										}
						)
					}
				}

			}
			Send_QR_Code_Email_on_Approval as "Send QR Code Email on Approval"
			{
				type =  form
				form = Appointment

				record event = on edit

				on update of Status
				{
					actions 
					{
						custom deluge script
						(
											// Fetch the Appointment record based on the current input ID
										appointmentRecord = Appointment[ID == input.ID];
										// Check if the status is 'Approved'
										if(input.Status == "Approved")
										{
											// Fetch the Visitor record linked to this appointment
											visitorRecord = Visitor[ID == appointmentRecord.Visitor.ID];
											// Fetch the Meeting Room record linked to this appointment
											meetingRoomRecord = Meeting_Room[ID == appointmentRecord.Meeting_Room.ID];
											// Fetch the Host record linked to this appointment
											hostRecord = Employee[ID == appointmentRecord.Host.ID];
											// Fetch the Visitor Pass record to get the QR Code
											passRecord = Visitor_Pass[Appointment.ID == appointmentRecord.ID];
											// Construct the email message
											emailMessage = "<h2>Appointment Approved</h2>";
											emailMessage = emailMessage + "<p>Dear " + visitorRecord.Visitor_Name.first_name + " " + visitorRecord.Visitor_Name.last_name + ",</p>";
											emailMessage = emailMessage + "<p>Your appointment has been approved.</p>";
											emailMessage = emailMessage + "<p><strong>Details:</strong></p>";
											emailMessage = emailMessage + "<ul>";
											emailMessage = emailMessage + "<li><strong>Host:</strong> " + hostRecord.Employee_Name.first_name + " " + hostRecord.Employee_Name.last_name + "</li>";
											emailMessage = emailMessage + "<li><strong>Meeting Room:</strong> " + meetingRoomRecord.Room_Name + "</li>";
											emailMessage = emailMessage + "<li><strong>Date & Time:</strong> " + appointmentRecord.Start_DateTime + "</li>";
											emailMessage = emailMessage + "<li><strong>Purpose:</strong> " + appointmentRecord.Purpose_Details + "</li>";
											emailMessage = emailMessage + "</ul>";
											emailMessage = emailMessage + "<p>Please find your Visitor Pass QR Code attached.</p>";
											// Send the email with the QR Code attachment
											sendmail
											[
												from :zoho.adminuserid
												to :input.Visitor_Email
												subject :"Appointment Approved - " + appointmentRecord.Appointment_ID
												message :emailMessage
												content type :HTML
												Attachments :file:passRecord.QR_Code
											]
										}
						)
					}
				}

			}
		}






	}
